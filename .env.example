# =============================================================================
# Student Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   macOS / Linux:         cp .env.example .env.local
#
# .env.local is listed in .gitignore and will never be committed.
# This template (.env.example) contains only safe placeholder values.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# Full PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local development example:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/student_marketplace
#
# Create the database first:
#   createdb student_marketplace          (psql CLI)
#   or: CREATE DATABASE student_marketplace;  (inside psql)
#
# pgvector extension must also be installed in PostgreSQL:
#   macOS (Homebrew):  brew install pgvector
#   Ubuntu:            sudo apt install postgresql-15-pgvector
#   Windows:           see https://github.com/pgvector/pgvector#installation
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/student_marketplace


# -----------------------------------------------------------------------------
# AUTHENTICATION SECRET (REQUIRED)
# -----------------------------------------------------------------------------
# Used to sign and verify JWT session cookies.
# Must be at least 32 characters long. Keep this value secret.
#
# Generate a secure random value (pick one method):
#   Node.js:           node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   OpenSSL:           openssl rand -hex 32
#   PowerShell:        -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# -----------------------------------------------------------------------------
AUTH_SECRET=replace_this_with_a_random_32_plus_character_secret_string


# -----------------------------------------------------------------------------
# OPENAI API KEY (OPTIONAL — semantic / AI-powered search only)
# -----------------------------------------------------------------------------
# When set, the search system uses OpenAI text-embedding-3-small (1536 dims)
# to power the semantic search layer and hybrid ranking.
#
# When NOT set, the application falls back to keyword-only search (PostgreSQL
# FTS via tsvector/tsquery). All other features work normally without this key.
#
# Obtain a key at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...


# -----------------------------------------------------------------------------
# APPLICATION URL (OPTIONAL — informational)
# -----------------------------------------------------------------------------
# Public base URL of the application. Used for reference in documentation.
# Next.js dev server defaults to http://localhost:3000 without this set.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
